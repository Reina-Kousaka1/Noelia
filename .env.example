DISCORD_TOKEN=replace-with-discord-bot-token
DISCORD_GUILD_ID=replace-with-discord-guild-id

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=noelia
POSTGRES_USER=noelia
POSTGRES_PASSWORD=replace-with-a-local-password

NODE_ENV=development

# Optional presentation-only prose; normal deterministic responses remain the fallback.
PERSONA_GENERATION_ENABLED=false
# Required only when PERSONA_GENERATION_ENABLED=true. Compatible Chat Completions endpoint.
PERSONA_GENERATION_ENDPOINT=
PERSONA_GENERATION_API_KEY=
PERSONA_GENERATION_MODEL=
PERSONA_GENERATION_TIMEOUT_MS=1100
PERSONA_GENERATION_MAX_CONCURRENT=2
PERSONA_GENERATION_MAX_PER_MINUTE=20

# Optional AutoMod listeners require enabling the matching privileged intents
# in the Discord Developer Portal as well as setting these environment switches.
# Message scanning uses GUILD_MESSAGES, MESSAGE_CONTENT, and GUILD_MEMBERS.
AUTOMOD_MESSAGE_SCANNING_ENABLED=false
# Join-burst review uses GUILD_MEMBERS; it never bans members automatically.
ANTI_RAID_JOIN_MONITORING_ENABLED=false
