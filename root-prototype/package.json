{
  "name": "@noelia-root/app",
  "description": "noelia-root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@rootsdk/client-app": "0.21.3",
    "@rootsdk/server-app": "0.21.3",
    "@noelia-root/gen-client": "file:./networking/gen/client",
    "@noelia-root/gen-server": "file:./networking/gen/server",
    "@noelia-root/gen-shared": "file:./networking/gen/shared"
  },
  "devDependencies": {
    "@rootsdk/dev-tools": "0.21.3",
    "typescript": "^5.8.2",
    "@types/node": "^22.10.2"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "node clean.js",
    "test": "npm run build --workspaces --if-present && node --test persona/persona.test.cjs scripts/devhost-config.test.cjs community-bot/test/community-help.test.cjs server/test/community-relay.test.cjs client/test/communityEvent.test.mjs client/test/viteConfig.test.mjs test/community-flow.test.cjs",
    "start:app": "npm run server --workspace @noelia-root/server",
    "start:bot": "npm run bot --workspace @noelia-root/community-bot"
  },
  "config": {
    "protocVersion": "36.2"
  },
  "workspaces": {
    "packages": [
      "./persona",
      "./networking",
      "./server",
      "./community-bot",
      "./client"
    ]
  }
}
